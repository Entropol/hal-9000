# Required
OPENROUTER_API_KEY=sk-or-...

# Protects your API. Clients send it as "X-API-Key: <value>" or "Authorization: Bearer <value>".
# Leave empty only for local testing.
API_KEY=change-me

# Telegram test bot (create one with @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to it. Empty = anyone who finds the bot.
# Message the bot once and it replies with your id if you're not on the list.
TELEGRAM_ALLOWED_USERS=

# Optional
# Turkish pitch in semitones: negative = deeper, positive = higher (-12 to 12, default 0)
# TR_PITCH_SHIFT=0
STT_MODEL=openai/whisper-large-v3
LLM_MODEL=google/gemini-2.5-flash
# STT_LANGUAGE=en
# LLM_MAX_TOKENS=300
# MAX_HISTORY_TURNS=10
# MAX_AUDIO_MB=25
# SYSTEM_PROMPT=...
